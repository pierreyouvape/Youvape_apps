{
  "permissions": {
    "allow": [
      "Bash(ssh youvape *)",
      "Bash(wait)",
      "Bash(git add *)",
      "Bash(git commit -m ' *)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(zip -r youvape-sav-client.zip youvape-sav-client -x *.DS_Store -x */.git/*)",
      "Bash(unzip -l youvape-sav-client.zip)",
      "Bash(git commit -m 'fix\\(achats\\): parseur LVP CSV — cellules quotées + date ISO *)",
      "Bash(grep -rn \"wp_product_id = \\\\$1 OR p.id = \\\\$1\\\\|p.id = \\\\$1 OR p.wp_product_id\\\\|wp_product_id = \\\\$1 OR.*id = \\\\$1\" backend/src --include=\"*.js\")",
      "Bash(grep -rn \"wp_product_id = \\\\$1\\\\|p.id = \\\\$1\" backend/src --include=\"*.js\")",
      "Bash(grep -oiE '<h[1-3][^>]*>[^<]{1,120}' \"API Nextore.html\")"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git pull origin main 2>&1 || true",
            "statusMessage": "Mise à jour du dépôt git..."
          }
        ]
      }
    ]
  }
}
